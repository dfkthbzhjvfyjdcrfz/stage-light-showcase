            }
            .header h1 { font-size: 2.2em; }
            .header p { font-size: 1.2em; }
            .header-right {
                width: 100%;
                align-items: stretch;
            }
            .button-panel {
                flex-direction: column;
                gap: 10px;
                width: 100%;
            }
            .effect-button {
                width: 100%;
                text-align: center;
                font-size: 1.2em;
                padding: 12px;
            }
            .warning {
                max-width: 100%;
                font-size: 0.6em;
                text-align: center;
                margin-top: 5px;
            }
            .eyes-container {
                gap: 30px;
                padding: 30px 0;
                flex-direction: row;
                flex-wrap: nowrap;
            }
            .eye-left, .eye-right {
                width: 160px;
                height: 70px;
            }
            .eye-left {
                clip-path: path("M20,58 C20,18 95,2 170,8 C245,14 315,28 340,62 C365,96 305,138 235,146 C165,154 95,146 48,112 C20,92 20,72 20,58");
            }
            .eye-right {
                clip-path: path("M20,58 C20,18 95,2 170,8 C245,14 315,28 340,62 C365,96 305,138 235,146 C165,154 95,146 48,112 C20,92 20,72 20,58");
                transform: scaleX(-1);
            }
            .pupil {
                width: 30px;
                height: 60px;
                border-radius: 40% / 50%;
            }
            .main-content h2 { font-size: 2.5em; }
            .main-content .question { font-size: 1.8em; margin: 15px 0; }
            .main-content .invite { font-size: 1.5em; }
            .video-section { padding: 10px; margin: 15px 0; }
            .video-title { font-size: 1.2em; margin-bottom: 20px; }
            .insta-gallery { padding: 15px 0; margin: 20px 0; }
            .insta-title { font-size: 2em; }
            .performance-title {
                font-size: 1.2em;
                border-left-width: 3px;
                padding-left: 15px;
                margin: 10px 0 20px 0;
            }
            .insta-item {
                flex: 0 0 160px;
                height: 160px;
            }
            .insta-carousel { gap: 12px; padding: 10px 0; }
            .contact-box { padding: 15px; margin: 20px 0; }
            .contact-box-title { font-size: 2em; letter-spacing: 5px; margin-bottom: 20px; }
            .contact-box-content { gap: 12px; }
            .contact-box-item { padding: 12px; gap: 12px; }
            .contact-box-icon { font-size: 2em; }
            .contact-box-text { font-size: 1em; }
            .bottom-text .line1 { font-size: 2.2em; }
            .bottom-text .line2 { font-size: 1.8em; }
            .bottom-text .line3 { font-size: 1.2em; max-width: 100%; }
            .footer { font-size: 0.9em; text-align: center; margin-top: 20px; padding-top: 20px; }
            .modal-prev, .modal-next { font-size: 2.5em; padding: 10px; }
            .modal-close { font-size: 3em; top: 15px; right: 20px; }
            .modal-image { max-width: 95vw; max-height: 85vh; }
        }
    </style>
</head>
