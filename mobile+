    <style>
        /* ===== ОБЩИЕ ===== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background-color: black;
            font-family: 'Courier New', monospace;
        }
        .black-board {
            max-width: 1500px;
            width: 100%;
            margin: 0 auto;
            background-color: black;
            padding: 40px;
            display: flex;
            flex-direction: column;
        }

        /* ===== КУРСОР ===== */
        body {
            cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 24 24"><text x="0" y="20" font-size="20" fill="%2300aaff">✦</text></svg>') 16 16, auto;
        }
        a, button, .insta-item, .video-section, .effect-button {
            cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 24 24"><text x="0" y="20" font-size="20" fill="%2300aaff">✦</text></svg>') 16 16, pointer;
        }

        /* ===== ГЛИТЧ ===== */
        .glitch-active {
            animation: glitch 0.1s infinite;
        }
        @keyframes glitch {
            0% { transform: translate(0); filter: hue-rotate(0deg) brightness(1); }
            20% { transform: translate(-3px, 2px); filter: hue-rotate(90deg) brightness(1.5); }
            40% { transform: translate(3px, -2px); filter: hue-rotate(180deg) brightness(0.8); }
            60% { transform: translate(-2px, 3px); filter: hue-rotate(270deg) brightness(1.3); }
            80% { transform: translate(2px, -3px); filter: hue-rotate(360deg) brightness(0.9); }
            100% { transform: translate(0); filter: hue-rotate(0deg) brightness(1); }
        }

        /* ===== СТРОБ (через ::before) ===== */
        .strobe-active::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 9999;
            animation: softStrobe 0.08s infinite !important;
        }
        @keyframes softStrobe {
            0% { background-color: rgba(0,0,0,0); backdrop-filter: blur(0px) brightness(1) contrast(1) hue-rotate(0deg); transform: skew(0deg,0deg); }
            25% { background-color: rgba(255,255,255,0.4); backdrop-filter: blur(2px) brightness(1.5) contrast(1.3) hue-rotate(45deg); transform: skew(1deg,0.5deg); }
            50% { background-color: rgba(255,255,255,0.7); backdrop-filter: blur(6px) brightness(2.5) contrast(2) hue-rotate(180deg) invert(0.15); transform: skew(-1.5deg,1deg); }
            75% { background-color: rgba(255,255,255,0.4); backdrop-filter: blur(3px) brightness(1.8) contrast(1.5) hue-rotate(270deg); transform: skew(2deg,-3deg); }
            100% { background-color: rgba(0,0,0,0); backdrop-filter: blur(0px) brightness(1) contrast(1) hue-rotate(0deg); transform: scale(2) translate(2%,-1%) rotate(2deg) skew(2deg,2deg); }
        }

        /* ===== ШАПКА ===== */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
            padding-bottom: 0;
            margin-bottom: 10px;
        }
        .header h1 {
            font-size: 4em;
            color: #00aaff;
            text-transform: lowercase;
            font-family: 'Courier New', monospace;
        }
        .header p {
            color: #00aaff;
            font-size: 2em;
            text-transform: lowercase;
        }
        .header-right {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 10px;
        }

        /* ===== КНОПКИ ===== */
        .button-panel {
            display: flex;
            gap: 20px;
        }
        .effect-button {
            background: transparent;
            color: #00aaff;
            border: 3px solid #00aaff;
            padding: 15px 30px;
            font-size: 1.5em;
            font-family: 'Inter', sans-serif;
            cursor: pointer;
            transition: all 0.1s ease;
            text-transform: uppercase;
            letter-spacing: 4px;
            user-select: none;
        }
        .effect-button:active {
            background: #00aaff;
            color: black;
            transform: scale(0.95);
        }
        .effect-button.glitch:active {
            background: #ff00ff;
            border-color: #ff00ff;
            box-shadow: 0 0 30px #ff00ff;
        }
        .effect-button.strobe:active {
            background: white;
            border-color: white;
            color: black;
            box-shadow: 0 0 30px white;
        }

        /* ===== ПРЕДУПРЕЖДЕНИЕ ===== */
        .warning {
            font-size: 0.7em;
            color: white;
            text-transform: uppercase;
            letter-spacing: 1px;
            text-align: right;
            opacity: 0.7;
            transition: opacity 0.3s ease;
            max-width: 280px;
        }
        .warning:hover { opacity: 1; }
        .warning-blink {
            animation: cautionBlink 1.2s infinite;
            font-weight: bold;
            color: #ff6680;
        }
        @keyframes cautionBlink {
            0% { opacity: 1; text-shadow: 0 0 0 #ff6680; }
            50% { opacity: 0.5; text-shadow: 0 0 3px #ff6680; }
            100% { opacity: 1; text-shadow: 0 0 0 #ff6680; }
        }

        /* ===== ОСНОВНОЙ КОНТЕНТ ===== */
        .main-content { padding: 40px 0; text-align: left; }
        .main-content h2 {
            font-size: 5em;
            color: white;
            text-transform: uppercase;
        }
        .main-content h2 span { color: #00aaff; }
        .main-content .question {
            font-size: 3em;
            color: #00aaff;
            margin: 30px 0;
            letter-spacing: 10px;
        }
        .main-content .invite {
            color: #00aaff;
            font-size: 2.5em;
            text-transform: uppercase;
            margin-top: 20px;
            line-height: 1.3;
        }

        /* ===== ГЛАЗА ===== */
        .eyes-container {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 200px;
            padding: 50px 0;
            border-top: 4px solid #00aaff;
        }
        .eye-left {
            position: relative;
            width: 400px;
            height: 160px;
            clip-path: path("M5,55 C50,5 130,2 180,2 C230,2 310,5 395,55 C420,95 310,150 230,155 C150,160 80,145 25,105 C3,85 3,70 5,55");
            background: #00aaff;
            transition: all 0.1s ease;
        }
        .eye-right {
            position: relative;
            width: 455px;
            height: 155px;
            clip-path: path("M5,55 C50,5 130,2 180,2 C230,2 310,5 395,55 C420,95 310,150 230,155 C150,160 80,145 25,105 C3,85 3,70 5,55");
            transform: scaleX(-1);
            background: #00aaff;
            transition: all 0.1s ease;
        }
        .pupil {
            position: absolute;
            width: 75px;
            height: 200px;
            background: black;
            border-radius: 45% / 49%;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            transition: transform 0.08s cubic-bezier(0.2, 0.9, 0.3, 1.1);
            will-change: transform;
        }
        .eye-left.blinking {
            clip-path: path("M20,65 C20,65 90,65 160,65 C230,65 300,65 330,65 C330,65 300,90 230,95 C160,100 90,95 45,85 C20,75 20,70 20,65");
            background: #00aaff;
            opacity: 1;
        }
        .eye-right.blinking {
            clip-path: path("M20,65 C20,65 90,65 160,65 C230,65 300,65 330,65 C330,65 300,90 230,95 C160,100 90,95 45,85 C20,75 20,70 20,65");
            transform: scaleX(-1);
            background: #00aaff;
            opacity: 1;
        }

        /* ===== ВИДЕОГАЛЕРЕЯ ===== */
        .video-section {
            margin: 40px 0;
            padding: 20px;
        }
        .video-title {
            color: #00aaff;
            font-size: 2em;
            margin-bottom: 44px;
            text-transform: uppercase;
        }
        .video-container {
            position: relative;
            padding-bottom: 56.25%;
            height: 0;
            overflow: hidden;
        }
        .video-container iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: none;
        }

        /* ===== ИНСТА-ГАЛЛЕРЕЯ ===== */
        .insta-gallery {
            margin: 60px 0;
            padding: 40px 0;
            border-bottom: 4px solid #00aaff;
        }
        .insta-title {
            font-size: 3em;
            color: #00aaff;
            margin-bottom: 30px;
            text-transform: uppercase;
            text-align: left;
        }
        .performance-title {
            font-size: 2.2em;
            color: #00aaff;
            margin: 20px 0 30px 0;
            text-transform: uppercase;
            letter-spacing: 3px;
            border-left: 4px solid #00aaff;
            padding-left: 20px;
            text-align: left;
            line-height: 1.3;
            word-break: break-word;
        }
        .insta-carousel {
            display: flex;
            overflow-x: auto;
            gap: 20px;
            padding: 20px 0;
            scroll-snap-type: x mandatory;
            -webkit-overflow-scrolling: touch;
        }
        .insta-item {
            flex: 0 0 300px;
            height: 300px;
            scroll-snap-align: start;
            cursor: pointer;
            transition: transform 0.3s ease;
            overflow: hidden;
        }
        .insta-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .insta-item:hover {
            transform: scale(1.02);
        }
        /* Ползунок */
        .insta-carousel::-webkit-scrollbar {
            height: 8px;
        }
        .insta-carousel::-webkit-scrollbar-track {
            background: #222;
            border-radius: 4px;
        }
        .insta-carousel::-webkit-scrollbar-thumb {
            background: #00aaff;
            border-radius: 4px;
            box-shadow: 0 0 10px #00aaff;
        }
        .insta-carousel::-webkit-scrollbar-thumb:hover {
            background: white;
            box-shadow: 0 0 15px white;
        }
        .insta-carousel {
            scrollbar-width: thin;
            scrollbar-color: #00aaff #222;
        }

        /* ===== КОНТАКТЫ ===== */
        .contact-box-title {
            font-size: 2.5em;
            color: #00aaff;
            margin-bottom: 40px;
            text-transform: uppercase;
            letter-spacing: 10px;
            text-align: center;
        }
        .contact-box-content {
            display: flex;
            flex-direction: column;
            gap: 25px;
            max-width: 500px;
            margin: 0 auto;
        }
        .contact-box-item {
            display: flex;
            align-items: center;
            gap: 20px;
            padding: 20px;
            text-decoration: none;
            transition: all 0.3s ease;
            background: transparent;
            color: #00aaff;
        }
        .contact-box-item:hover {
            background: #00aaff;
            color: black;
            transform: scale(1.02);
        }
        .contact-box-icon {
            font-size: 2.5em;
            color: inherit;
        }
        .contact-box-item:hover .contact-box-icon {
            color: black;
        }
        .contact-box-text {
            font-size: 1.3em;
            color: #00aaff;
            text-transform: lowercase;
            letter-spacing: 1px;
            word-break: break-all;
        }
        .contact-box-item:hover .contact-box-text {
            color: black;
        }

        /* ===== НИЗ ===== */
        .bottom-text {
            padding: 40px 0;
        }
        .bottom-text .line1 {
            font-size: 4em;
            color: #00aaff;
            font-weight: bold;
            text-transform: uppercase;
        }
        .bottom-text .line2 {
            font-size: 3.5em;
            color: white;
            font-weight: bold;
            text-transform: uppercase;
            margin: 10px 0;
        }
        .bottom-text .line3 {
            font-size: 2.5em;
            color: #00aaff;
            text-transform: uppercase;
            line-height: 1.3;
            max-width: 80%;
        }
        .footer {
            text-align: right;
            padding-top: 30px;
            margin-top: 60px;
            border-top: 4px solid #00aaff;
            color: #00aaff;
            font-size: 1.2em;
            text-transform: uppercase;
